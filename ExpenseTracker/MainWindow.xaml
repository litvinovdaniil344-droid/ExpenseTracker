<Window x:Class="ExpenseTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Трекер расходов" Height="500" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Дата:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker x:Name="dpDate" Width="120" Margin="0,0,10,0"/>

            <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="txtCategory" Width="120" Margin="0,0,10,0"/>

            <TextBlock Text="Описание:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="txtDescription" Width="150" Margin="0,0,10,0"/>

            <TextBlock Text="Сумма:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="txtAmount" Width="80" Margin="0,0,10,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="btnAdd" Content="Добавить" Width="100" Margin="0,0,10,0" Click="BtnAdd_Click"/>
            <Button x:Name="btnRefresh" Content="Обновить" Width="100" Margin="0,0,10,0" Click="BtnRefresh_Click"/>
            <Button x:Name="btnDelete" Content="Удалить" Width="100" Click="BtnDelete_Click"/>
        </StackPanel>
        <DataGrid x:Name="dgExpenses" Grid.Row="2" AutoGenerateColumns="True" 
                  IsReadOnly="True" SelectionMode="Single"/>
        <Border Grid.Row="3" Background="#F0F0F0" BorderBrush="LightGray" BorderThickness="1" 
            Margin="0,1,0,9" Padding="10,5" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="ИТОГО: " FontWeight="Bold" FontSize="16" Height="21"/>
                <TextBlock x:Name="txtTotalSum" Text="0.00" FontWeight="Bold" FontSize="16" 
                       Foreground="DarkRed" Height="26"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>